#!/usr/bin/env zsh
# Generate docs/COMMANDS.md from the live option definitions and help metadata.
emulate -R zsh
ZUI_ROOT=${0:A:h:h}
export ZUI_ROOT
source "$ZUI_ROOT/lib/zui.zsh"
ZUI_ANSI_PROFILE=none

mkdir -p "$ZUI_ROOT/docs"
doc="$ZUI_ROOT/docs/COMMANDS.md"

{
  print -r -- '# Command reference'
  print
  print -r -- '<!-- Generated by tools/gen-command-docs.zsh. Run `make docs` after changing flags. -->'
  print
  print -r -- 'The canonical help for any command is `zui <command> --help` (or'
  print -r -- '`zui help <command>`). This page mirrors the live option definitions. Types are'
  print -r -- '`flag`, `str`, `int` or `multi` (repeatable).'
  print
  print -r -- '## Global options'
  print
  print -r -- 'These may precede the command:'
  print
  print -r -- '| Option | Meaning |'
  print -r -- '|---|---|'
  print -r -- '| `-h, --help` | Show help (use `zui <cmd> --help` for one command). |'
  print -r -- '| `-v, --version` | Print the version. |'
  print -r -- '| `--theme NAME` | Palette: default, light, dracula, gruvbox, nord, solarized, catppuccin, mono. |'
  print -r -- '| `--no-color` | Disable colour (also honours `NO_COLOR`). |'
  print -r -- '| `--ascii` | ASCII borders and glyphs. |'
  print -r -- '| `--debug` | Debug output on stderr. |'
  print
  print -r -- '## Exit codes'
  print
  print -r -- '`0` success · `1` cancel/negative · `2` usage error · `3` no terminal · `124` timeout · `130` Ctrl-C.'
  print

  local cmd def short long type desc defval
  for cmd in "${_ZUI_COMMANDS[@]}"; do
    print -r -- "## \`$cmd\`"
    print
    print -r -- "${_ZUI_CMD_DESC[$cmd]:-}"
    print
    print -r -- '```text'
    print -r -- "${_ZUI_CMD_USAGE[$cmd]:-zui $cmd}"
    print -r -- '```'
    print
    [[ -n ${_ZUI_CMD_LONG[$cmd]:-} ]] && { print -r -- "${_ZUI_CMD_LONG[$cmd]}"; print; }

    local defvar="_ZUI_OPTDEF_$cmd"
    if (( ${+parameters[$defvar]} )); then
      local -a defs
      defs=("${(@P)defvar}")
      print -r -- '| Flag | Type | Default | Description |'
      print -r -- '|---|---|---|---|'
      for def in "${defs[@]}"; do
        IFS='|' read -r short long type desc defval <<< "$def"
        local flag="\`--$long\`"
        [[ -n $short ]] && flag="\`-$short\`, $flag"
        [[ $type == multi ]] && desc+=" (repeatable)"
        local shown=${defval:-—}
        [[ $shown == 0 && $type == flag ]] && shown=—
        print -r -- "| $flag | $type | $shown | $desc |"
      done
      print
    fi

    local styles=${_ZUI_CMD_STYLES[$cmd]:-}
    if [[ -n $styles ]]; then
      print -r -- '**Style flags**'
      print
      print -r -- 'Every part below accepts `--<part>.foreground` and `--<part>.background`:'
      print
      local joined="${(j:, :)${=styles}}"
      print -r -- '`'"$joined"'`'
      print
    fi

    local data=${_ZUI_KEYMAP[$cmd]:-}
    if [[ -n $data ]]; then
      print -r -- '**Keys**'
      print
      print -r -- '| Key | Action |'
      print -r -- '|---|---|'
      for line in "${(@f)data}"; do
        print -r -- "| \`${line%%|*}\` | ${line#*|} |"
      done
      print
    fi

    data=${_ZUI_EXAMPLES[$cmd]:-}
    if [[ -n $data ]]; then
      print -r -- '**Examples**'
      print
      print -r -- '```sh'
      for line in "${(@f)data}"; do print -r -- "$line"; done
      print -r -- '```'
      print
    fi

    data=${_ZUI_NOTES[$cmd]:-}
    if [[ -n $data ]]; then
      print -r -- '**Notes**'
      print
      for line in "${(@f)data}"; do print -r -- "- $line"; done
      print
    fi
  done
} > "$doc"

print -r -- "wrote $doc"
